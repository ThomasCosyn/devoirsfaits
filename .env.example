# Clé secrète pour signer les sessions — générez avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Base Postgres existante (schéma dédié `devoirsfaits` créé automatiquement)
DATABASE_URL=postgresql://user:password@host:5432/ma_base

# API Mistral (https://console.mistral.ai/api-keys)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest

# Langfuse Cloud (https://cloud.langfuse.com → Settings → API Keys)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
