% askme.sty — Insère un petit symbole cliquable vers l'assistant "Devoirs Faits".
%
% Les énoncés et corrections sont extraits des fichiers .tex par le CLI :
%   python cli/manage.py sync feuille.tex corrige.tex
% (le .tex est la source unique, pas de double saisie)
%
% Usage dans la feuille élève :
%   \usepackage{askme}
%   \askmesetup{assistant.mondomaine.fr}        % https par défaut (production)
%   \askmesetup[http]{localhost:8000}           % test local (uvicorn sans TLS)
%   ...
%   \begin{askme}{ex-pgcd-01}{PGCD - Exercice 1}{3A}
%   Déterminer le PGCD de 120 et 84. En d\'eduire la forme irr\'eductible
%   de la fraction $\frac{84}{120}$.
%   \end{askme}
%
% Option showurl : affiche aussi l'URL en toutes lettres à côté de l'icône,
% pour les visionneurs PDF qui ne supportent pas les liens cliquables
% (photocopie, aperçu sur téléphone, etc.) :
%   \usepackage[showurl]{askme}
%
% Usage dans le corrigé (fichier séparé, jamais distribué) :
%   \begin{askmecorrection}{ex-pgcd-01}
%   1) On décompose : $120 = 2^3 \times 3 \times 5$...
%   \end{askmecorrection}

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{askme}[2026/01/16 v2.1 Devoirs Faits clickable helper]
\RequirePackage{xcolor}
\RequirePackage{hyperref}

% Options du package
\newif\ifaskme@showurl
\DeclareOption{showurl}{\askme@showurltrue}
\ProcessOptions\relax

% Les visionneurs compatibles ouvrent les liens dans une nouvelle fenêtre/onglet.
% Remarque : le format PDF ne permet pas de le garantir partout ; Acrobat,
% Firefox et la plupart des navigateurs respectent pdfnewwindow, mais certains
% visionneurs (Aperçu macOS, mobiles) décident eux-mêmes.
\hypersetup{pdfnewwindow=true}

% Schéma de l'URL : https en production, http possible en local
\newcommand{\askme@scheme}{https}
% Domaine de l'assistant (sans schéma, ex : assistant.mondomaine.fr ou localhost:8000)
\newcommand{\askme@domain}{assistant.mondomaine.fr}

% \askmesetup[http]{localhost:8000}  ou  \askmesetup{assistant.mondomaine.fr}
\newcommand{\askmesetup}[2][https]{%
  \renewcommand{\askme@scheme}{#1}%
  \renewcommand{\askme@domain}{#2}%
}

% URL complète d'un exercice
\newcommand{\askme@url}[1]{\askme@scheme://\askme@domain/e/#1}

% \askmeniveau{2nd} : déclaré la valeur par défaut du niveau pour les exercices
% \begin{exo}[slug] du même fichier (lu par le CLI au moment du sync).
\newcommand{\askmeniveau}[1]{}

% Lien cliquable autonome (nouvel onglet) vers un exercice,
% à utiliser dans vos propres environnements, ex. : \askmelink{mon-slug}
\newcommand{\askmelink}[1]{%
  \href{\askme@url{#1}}{\askme@icon}%
  \ifaskme@showurl\,{\footnotesize\ttfamily\href{\askme@url{#1}}{\askme@url{#1}}}\fi
}

% Icône cliquable : boussole teal si fontawesome5 est chargé, sinon astérisque
\newcommand{\askme@icon}{%
  \@ifpackageloaded{fontawesome5}{{\small\color{teal}\faIcon{compass}}}%
  {{\small\color{teal}$\ast$}}%
}

% Environnement exercice : titre + icône cliquable (nouvel onglet),
% puis le corps (l'énoncé)
% #1 = slug (identifiant unique de l'exercice dans la base)
% #2 = titre affiché
% #3 = classe
\newenvironment{askme}[3]{%
  \par\vspace{8pt}%
  \noindent\textbf{\textsc{#2}}\hfill
  {\href{\askme@url{#1}}{\askme@icon}}%
  \ifaskme@showurl\,{\footnotesize\ttfamily\href{\askme@url{#1}}{\askme@url{#1}}}\fi
  \par\vspace{3pt}%
  \noindent\ignorespaces
}{%
  \par\vspace{8pt}%
}

% Environnement correction (fichier corrigé) : affiche le texte de la correction
% #1 = slug de l'exercice correspondant
\newenvironment{askmecorrection}[1]{%
  \par\vspace{8pt}%
  \noindent\textbf{\textsc{Correction (#1)}}\par\vspace{3pt}%
  \noindent\ignorespaces
}{%
  \par\vspace{8pt}%
}

\endinput
